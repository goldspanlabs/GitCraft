#!/bin/sh
# Fast Rust checks (fmt, clippy) before anything leaves the machine.
# Tests run in CI (see .github/workflows/ci.yml), not here.
set -e

# GUI apps launch git with a minimal PATH, so make sure cargo can be found.
export PATH="$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
cd "$(git rev-parse --show-toplevel)"

echo "pre-push: cargo fmt --check" >&2
cargo fmt --manifest-path rust-core/Cargo.toml --check >&2

echo "pre-push: cargo clippy" >&2
cargo clippy --manifest-path rust-core/Cargo.toml --all-targets -- -D warnings >&2
