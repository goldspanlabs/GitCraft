namespace gitcraft_core {};

[Error]
interface GitCraftError {
  Message(string msg);
};

enum CommitSort {
  "ByDate",
  "Topological"
};

enum PullStrategy {
  "GitConfig",
  "Merge",
  "Rebase",
  "FastForwardOnly"
};

enum RefKind {
  "LocalBranch",
  "RemoteBranch",
  "Tag",
  "Head"
};

dictionary RefBadge {
  string name;
  RefKind kind;
  boolean is_current;
};

dictionary GraphEdge {
  u32 from_lane;
  u32 to_lane;
  boolean is_merge;
  u8 color_idx;
};

dictionary StyleSpan {
  u32 start_utf16;
  u32 len_utf16;
  string foreground;
};

dictionary DiffRow {
  string kind;
  string text;
  u32? old_line;
  u32? new_line;
  sequence<StyleSpan> spans;
};

dictionary FileChange {
  string path;
  string status;
  boolean staged;
};

dictionary CommitRow {
  string oid_hex;
  string short_oid;
  string summary;
  string author_name;
  string author_email;
  i64 timestamp;
  u32 lane;
  u8 color_idx;
  u32 max_lanes;
  sequence<GraphEdge> edges;
  sequence<RefBadge> refs;
  boolean is_remote_only;
  boolean is_unpushed;
};

dictionary CommitDetail {
  string oid_hex;
  string short_oid;
  string summary;
  string body;
  string author_name;
  string author_email;
  i64 timestamp;
  sequence<string> parent_oids;
  sequence<FileChange> files;
};

dictionary BranchInfo {
  string name;
  string full_ref;
  boolean is_remote;
  boolean is_head;
  string target_oid_hex;
  u32 ahead;
  u32 behind;
  boolean is_merged;
  boolean is_default;
};

dictionary TagInfo {
  string name;
  string full_ref;
  string target_oid_hex;
  i64 created_timestamp;
};

dictionary RemoteInfo {
  string name;
  string fetch_url;
  string push_url;
};

dictionary StashInfo {
  u32 index;
  string name;
  string message;
};

dictionary RepoStatus {
  sequence<string> files;
  sequence<FileChange> staged_files;
  sequence<FileChange> unstaged_files;
  string branch;
  boolean is_clean;
  boolean is_merging;
  boolean is_rebasing;
  boolean has_conflicts;
};

interface RepoSession {
  [Throws=GitCraftError]
  constructor(string path);

  [Throws=GitCraftError]
  RepoStatus status();

  void set_commit_sort(CommitSort sort);

  [Throws=GitCraftError]
  sequence<CommitRow> get_commit_graph(u32 offset, u32 limit, string? search_query);

  [Throws=GitCraftError]
  sequence<CommitRow> get_branch_graph(u32 offset, u32 limit, string? search_query);

  [Throws=GitCraftError]
  CommitDetail get_commit_detail(string oid_hex);

  [Throws=GitCraftError]
  sequence<DiffRow> get_commit_diff(string oid_hex, string? path);

  [Throws=GitCraftError]
  sequence<DiffRow> get_working_diff(string? path, boolean staged);

  [Throws=GitCraftError]
  sequence<BranchInfo> list_branches();

  [Throws=GitCraftError]
  sequence<TagInfo> list_tags();

  [Throws=GitCraftError]
  void create_tag(string tag_name, string? target, string? message, boolean push_to_remote);

  [Throws=GitCraftError]
  void delete_tag(string tag_name, boolean delete_remote);

  [Throws=GitCraftError]
  void push_tag(string tag_name);

  [Throws=GitCraftError]
  sequence<StashInfo> list_stashes();

  [Throws=GitCraftError]
  void stash_push(string? message, boolean include_untracked);

  [Throws=GitCraftError]
  void stash_apply(u32 index);

  [Throws=GitCraftError]
  void stash_pop(u32 index);

  [Throws=GitCraftError]
  void stash_drop(u32 index);

  [Throws=GitCraftError]
  void checkout_branch(string branch_name);

  [Throws=GitCraftError]
  void create_branch(string branch_name, string? start_point, boolean checkout);

  [Throws=GitCraftError]
  void delete_branch(string branch_name, boolean force);

  [Throws=GitCraftError]
  void merge_branch(string branch_name);

  [Throws=GitCraftError]
  void abort_merge();

  [Throws=GitCraftError]
  sequence<DiffRow> diff();

  [Throws=GitCraftError]
  void stage(string path);

  [Throws=GitCraftError]
  void unstage(string path);

  [Throws=GitCraftError]
  void stage_all();

  [Throws=GitCraftError]
  void unstage_all();

  [Throws=GitCraftError]
  void discard_file(string path);

  [Throws=GitCraftError]
  sequence<RemoteInfo> list_remotes();

  [Throws=GitCraftError]
  void add_remote(string name, string url);

  [Throws=GitCraftError]
  void set_remote_url(string name, string url);

  [Throws=GitCraftError]
  void rename_remote(string old_name, string new_name);

  [Throws=GitCraftError]
  void remove_remote(string name);

  [Throws=GitCraftError]
  void fetch_remote(string name, boolean include_tags);

  [Throws=GitCraftError]
  void ignore_path(string path, boolean local_only);

  [Throws=GitCraftError]
  void commit(string message);

  [Throws=GitCraftError]
  void fetch(boolean include_tags);

  [Throws=GitCraftError]
  void pull(PullStrategy strategy);
  [Throws=GitCraftError]
  void abort_rebase();
  [Throws=GitCraftError]
  void continue_rebase();

  [Throws=GitCraftError]
  void push();

  boolean take_dirty();
  boolean take_graph_dirty();
};
