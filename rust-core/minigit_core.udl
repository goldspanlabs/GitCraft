namespace minigit_core {};

[Error]
interface MiniGitError {
  Message(string msg);
};

enum RefKind {
  "LocalBranch",
  "RemoteBranch",
  "Tag",
  "Head"
};

dictionary RefBadge {
  string name;
  RefKind kind;
  boolean is_current;
};

dictionary GraphEdge {
  u32 from_lane;
  u32 to_lane;
  boolean is_merge;
  u8 color_idx;
};

dictionary StyleSpan {
  u32 start_utf16;
  u32 len_utf16;
  string foreground;
};

dictionary DiffRow {
  string kind;
  string text;
  u32? old_line;
  u32? new_line;
  sequence<StyleSpan> spans;
};

dictionary FileChange {
  string path;
  string status;
  boolean staged;
};

dictionary CommitRow {
  string oid_hex;
  string short_oid;
  string summary;
  string author_name;
  i64 timestamp;
  u32 lane;
  u8 color_idx;
  u32 max_lanes;
  sequence<GraphEdge> edges;
  sequence<RefBadge> refs;
  boolean is_remote_only;
};

dictionary CommitDetail {
  string oid_hex;
  string short_oid;
  string summary;
  string body;
  string author_name;
  string author_email;
  i64 timestamp;
  sequence<string> parent_oids;
  sequence<FileChange> files;
};

dictionary BranchInfo {
  string name;
  string full_ref;
  boolean is_remote;
  boolean is_head;
  string target_oid_hex;
  u32 ahead;
  u32 behind;
};

dictionary TagInfo {
  string name;
  string full_ref;
  string target_oid_hex;
};

dictionary StashInfo {
  u32 index;
  string name;
  string message;
};

dictionary RepoStatus {
  sequence<string> files;
  sequence<FileChange> staged_files;
  sequence<FileChange> unstaged_files;
  string branch;
  boolean is_clean;
  boolean is_merging;
  boolean has_conflicts;
};

interface RepoSession {
  [Throws=MiniGitError]
  constructor(string path);

  [Throws=MiniGitError]
  RepoStatus status();

  [Throws=MiniGitError]
  sequence<CommitRow> get_commit_graph(u32 offset, u32 limit, string? search_query);

  [Throws=MiniGitError]
  CommitDetail get_commit_detail(string oid_hex);

  [Throws=MiniGitError]
  sequence<DiffRow> get_commit_diff(string oid_hex, string? path);

  [Throws=MiniGitError]
  sequence<DiffRow> get_working_diff(string? path, boolean staged);

  [Throws=MiniGitError]
  sequence<BranchInfo> list_branches();

  [Throws=MiniGitError]
  sequence<TagInfo> list_tags();

  [Throws=MiniGitError]
  void create_tag(string tag_name, string? target, string? message, boolean push_to_remote);

  [Throws=MiniGitError]
  void delete_tag(string tag_name, boolean delete_remote);

  [Throws=MiniGitError]
  void push_tag(string tag_name);

  [Throws=MiniGitError]
  sequence<StashInfo> list_stashes();

  [Throws=MiniGitError]
  void stash_push(string? message, boolean include_untracked);

  [Throws=MiniGitError]
  void stash_apply(u32 index);

  [Throws=MiniGitError]
  void stash_pop(u32 index);

  [Throws=MiniGitError]
  void stash_drop(u32 index);

  [Throws=MiniGitError]
  void checkout_branch(string branch_name);

  [Throws=MiniGitError]
  void create_branch(string branch_name, string? start_point, boolean checkout);

  [Throws=MiniGitError]
  void delete_branch(string branch_name, boolean force);

  [Throws=MiniGitError]
  void merge_branch(string branch_name);

  [Throws=MiniGitError]
  void abort_merge();

  [Throws=MiniGitError]
  sequence<DiffRow> diff();

  [Throws=MiniGitError]
  void stage(string path);

  [Throws=MiniGitError]
  void unstage(string path);

  [Throws=MiniGitError]
  void stage_all();

  [Throws=MiniGitError]
  void unstage_all();

  [Throws=MiniGitError]
  void discard_file(string path);

  [Throws=MiniGitError]
  void commit(string message);

  [Throws=MiniGitError]
  void fetch();

  [Throws=MiniGitError]
  void pull();

  [Throws=MiniGitError]
  void push();

  boolean take_dirty();
};
